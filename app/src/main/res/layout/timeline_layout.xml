<?xml version="1.0" encoding="utf-8"?>
<!-- 底部时间轴栏：传输控制 + 时间轴轨道 + 操作按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/key_frame_timeline"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:paddingVertical="10dp"
    android:paddingHorizontal="5dp"
    android:background="@drawable/chapter_nav">

    <!-- Row 1: 传输控制 + 时间轴轨道 + 时间显示 (56dp) -->
    <LinearLayout
        android:id="@+id/timeline_button_row"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="6dp">

        <!-- 上一个关键帧 -->
        <ImageButton
            android:id="@+id/btn_prev_keyframe"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="上一个关键帧"
            android:visibility="visible"
            app:srcCompat="@drawable/ic_skip_previous_24"
            app:tint="?actionBarTintColor" />

        <!-- 播放/暂停 -->
        <ImageButton
            android:id="@+id/btn_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="播放/暂停"
            android:visibility="visible"
            app:srcCompat="@drawable/ic_play_arrow_24dp"
            app:tint="?actionBarTintColor" />

        <!-- 下一个关键帧 -->
        <ImageButton
            android:id="@+id/btn_next_keyframe"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="下一个关键帧"
            android:visibility="visible"
            app:srcCompat="@drawable/ic_skip_next_24"
            app:tint="?actionBarTintColor" />

        <!-- 时间轴轨道主体 -->
        <eu.kanade.tachiyomi.ui.reader.viewer.KeyFrameTimelineView
            android:id="@+id/key_frame_timeline_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:layout_weight="1" />

        <!-- 时间显示 -->
        <TextView
            android:id="@+id/timeline_time_display"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:fontFamily="monospace"
            android:textColor="?attr/colorOnBackground"
            android:textSize="11sp"
            tools:text="30.0/30.0s" />
    </LinearLayout>

    <!-- Row 2: 操作按钮行 (40dp) -->
    <LinearLayout
        android:id="@+id/timeline_action_row"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <!-- 添加关键帧按钮 -->
        <ImageButton
            android:id="@+id/btn_add_keyframe"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="添加关键帧"
            android:visibility="visible"
            app:srcCompat="@drawable/ic_add_24dp"
            app:tint="?actionBarTintColor" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 编辑面板按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_expand_edit"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="编辑面板"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
